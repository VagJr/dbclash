rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profile, Level, Inventory & Cloud Save
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null || true;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Realtime Multiplayer Rooms (Ranked 1v1, Ranked 2v2, Co-Op Raid Boss)
    match /rooms/{roomId} {
      allow read, create, update, delete: if true;
    }
    
    // Global Player Rankings & Leaderboard Entries
    match /leaderboards/{entry} {
      allow read: if true;
      allow create, update: if true;
    }

    // Matchmaking Queues (Ranked 1v1, 2v2 Team, Co-Op Raid)
    match /matchmaking/{queueId} {
      allow read, create, update, delete: if true;
    }

    // Global Chat & Dojo Guild Feeds
    match /chat/{messageId} {
      allow read: if true;
      allow create: if true;
    }
  }
}
