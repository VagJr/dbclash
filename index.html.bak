    <button class="nav-item" data-tab="lobby"><span class="nav-icon">⚔️</span><span class="nav-label">Lobby</span></button>
    <button class="nav-item" data-tab="arena"><span class="nav-icon">🔥</span><span class="nav-label">Arena</span></button>
    <button class="nav-item" data-tab="deck"><span class="nav-icon">🎴</span><span class="nav-label">Decks</span></button>
    <button class="nav-item" data-tab="store"><span class="nav-icon">🎁</span><span class="nav-label">Loja</span></button>
    <button class="nav-item" data-tab="dojos"><span class="nav-icon">🏯</span><span class="nav-label">Dojos</span></button>
    <button class="nav-item" data-tab="chat"><span class="nav-icon">💬</span><span class="nav-label">Chat</span></button>
  </nav>

  <!-- ═══ Bottom Tab Bar (Mobile) ═══ -->
  <nav id="bottom-bar">
    <button class="btab active" data-tab="landing"><span class="btab-icon">🏠</span>Home</button>
    <button class="btab" data-tab="profile"><span class="btab-icon">👤</span>Perfil</button>
    <button class="btab" data-tab="ranked"><span class="btab-icon">🏆</span>Ranked</button>
    <button class="btab" data-tab="quests"><span class="btab-icon">📜</span>Missões</button>
    <button class="btab" data-tab="arena"><span class="btab-icon">🔥</span>Arena</button>
    <button class="btab" data-tab="deck"><span class="btab-icon">🎴</span>Decks</button>
    <button class="btab" data-tab="store"><span class="btab-icon">🎁</span>Loja</button>
  </nav>

  <!-- ═══ Top Header Bar ═══ -->
  <header id="app-header">
    <div class="brand-logo">
      <span class="star">★</span>
